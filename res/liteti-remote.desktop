[Desktop Entry]
Name=Liteti Remote
GenericName=Acesso Remoto
Comment=Liteti Remote - Acesso Remoto Seguro
Exec=liteti-remote %u
Icon=liteti-remote
Terminal=false
Type=Application
StartupNotify=true
Categories=Network;RemoteAccess;GTK;
Keywords=internet;linux;dart;rust;remote-control;p2p;teamviewer;rust-lang;rdp;remote-desktop;vnc;
Actions=new-window;
StartupWMClass=liteti-remote

X-Desktop-File-Install-Version=0.23

[Desktop Action new-window]
Name=Abrir uma Nova Janela
Exec=liteti-remote %u
